OPSPILOT_ENV=development
OPSPILOT_DATA_DIR=./data
DATABASE_URL=postgresql+psycopg://opspilot:opspilot_dev@localhost:5432/opspilot
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev
POSTGRES_PORT=5432
CHROMA_PORT=8001
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_PREFIX=opspilot
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=hashing-tfidf-v1
EMBEDDING_DIMENSIONS=1024
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=
OPSPILOT_PORT=7860
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot_dev@postgres:5432/opspilot
SESSION_TTL_HOURS=72
MAX_INVESTIGATIONS_PER_SESSION=5
MAX_ACTIVE_INVESTIGATION_SECONDS=90
MAX_TOOL_CALLS_PER_INVESTIGATION=10
MAX_INVESTIGATION_TURNS=8
MAX_TOKENS_PER_INVESTIGATION=20000
MAX_ESTIMATED_COST_USD=0.10
APPROVAL_TTL_MINUTES=30
LLM_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

